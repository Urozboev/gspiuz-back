# ---------------------------------------------------------------------
# GSPI backend — nginx namunasi
#
# Bu konfiguratsiya **backend serveri** uchun (institut serveri).
# Frontend (Next.js) boshqa serverda — ahost.uz hostingida — turadi va
# bu yerga tashqaridan, HTTPS orqali murojaat qiladi.
#
# Shu serverda nima bor:
#   • Laravel admin paneli  — xodimlar uchun ochiq
#   • API                   — faqat ahost serveri uchun
#   • Yuklangan fayllar     — hamma uchun ochiq (rasm, hujjat)
#
# Nusxa olgach ALBATTA to'g'irlang:
#   server_name, root katalogi, php-fpm socket nomi,
#   ssl_certificate yo'llari, API prefiksi va ahost IP manzili.
# ---------------------------------------------------------------------

# HTTP → HTTPS. Sertifikat yangilash so'rovlari bundan mustasno.
server {
    listen 80;
    listen [::]:80;

    server_name admin.gspi.uz;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name admin.gspi.uz;

    root /var/www/gspi-backend/public;
    index index.php;

    ssl_certificate     /etc/letsencrypt/live/admin.gspi.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.gspi.uz/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 20M;   # rasm va hujjat yuklash uchun

    charset utf-8;

    access_log /var/log/nginx/gspi-access.log;
    error_log  /var/log/nginx/gspi-error.log;

    # ------------------------------------------------------------------
    # Yuklangan fayllar — nginx o'zi beradi, PHP aralashmaydi.
    # Bular saytda ko'rinadi, shuning uchun hamma uchun ochiq.
    # ------------------------------------------------------------------
    location ^~ /upload/ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    location ^~ /storage/ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    location ^~ /assets/ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    # ------------------------------------------------------------------
    # API — FAQAT frontend serveri uchun.
    #
    # `<API_PREFIKSI>` o'rniga `.env` dagi `API_PREFIX` qiymatini qo'ying.
    # `<AHOST_IP>` — ahost.uz serverining tashqi IP manzili, uni
    # hostingdan so'rang.
    #
    # Prefiksning maxfiyligi himoyaning bir qismi, lekin yagonasi
    # bo'lmasligi kerak: API endi internetdan ko'rinadi.
    # ------------------------------------------------------------------
    location ^~ /<API_PREFIKSI>/ {
        allow <AHOST_IP>;
        deny  all;

        try_files $uri /index.php?$query_string;
    }

    # ------------------------------------------------------------------
    # Admin panel — xodimlar uchun, IP bilan cheklanmaydi.
    # ------------------------------------------------------------------
    location ^~ /admin/ {
        try_files $uri /index.php?$query_string;
    }

    location = /login {
        try_files $uri /index.php?$query_string;
    }

    location = /logout {
        try_files $uri /index.php?$query_string;
    }

    # Laravelning kirish nuqtasidan boshqa hech qanday PHP fayl
    # bajarilmasin. `public/` ichida adminer kabi begona skriptlar
    # qolib ketishi mumkin; ular bajarilsa, bazaga to'g'ridan-to'g'ri
    # kirish yo'li ochiladi.
    # Bu qoida quyidagi `.php` qoidasidan OLDIN turishi shart.
    location ~ ^/(?!index\.php$).*\.php$ {
        deny all;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 60s;
    }

    # ------------------------------------------------------------------
    # Qolgan hamma narsa — Laravelga.
    #
    # Sayt sahifalari bu yerda EMAS: ular gspi.uz da, boshqa serverda.
    # Shuning uchun bu yerga tushgan begona so'rov 404 oladi.
    # ------------------------------------------------------------------
    location / {
        try_files $uri /index.php?$query_string;
    }

    # Yashirin fayllar (.env, .git) hech qachon berilmasin.
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
    }
}
