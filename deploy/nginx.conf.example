# GSPI sayti — nginx konfiguratsiyasi (qoralama)
#
# Bitta serverda ikkita ilova ishlaydi:
#   • Laravel (backend + admin panel) — php-fpm orqali, public/ katalogi
#   • Next.js (frontend) — 127.0.0.1:3000 da, `npm run build && npm start`
#
# Manzillar taqsimoti:
#   /admin/…    → Laravel admin paneli
#   /login      → Laravel autentifikatsiyasi
#   /upload/…   → fayllar, to'g'ridan-to'g'ri diskdan (PHP ishlatilmaydi)
#   /storage/…  → storage:link orqali ulangan fayllar
#   /<API prefiksi>/… → Laravel API
#   qolgan hammasi → Next.js
#
# DIQQAT: quyidagi qiymatlar server tanlangandan keyin to'ldiriladi —
#   server_name, ssl_certificate yo'llari, root katalogi, php-fpm socket nomi.

# HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name gspi.uz www.gspi.uz;

    # Let's Encrypt tekshiruvi shu yerdan o'tadi.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name gspi.uz www.gspi.uz;

    # Laravel'ning public/ katalogi.
    root /var/www/gspi-backend/public;
    index index.php;

    ssl_certificate     /etc/letsencrypt/live/gspi.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gspi.uz/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Xavfsizlik sarlavhalari. Frontend o'zi ham qo'yadi; bu yerdagilari
    # Laravel bergan javoblar (admin panel, API) uchun ham amal qiladi.
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 20M;   # rasm va hujjat yuklash uchun

    charset utf-8;

    access_log /var/log/nginx/gspi-access.log;
    error_log  /var/log/nginx/gspi-error.log;

    # ------------------------------------------------------------------
    # Fayllar — PHP ham, Node ham aralashmaydi, nginx o'zi beradi.
    # ------------------------------------------------------------------
    location ^~ /upload/ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    location ^~ /storage/ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    location ^~ /assets/ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    # ------------------------------------------------------------------
    # Laravel: admin panel, autentifikatsiya va API
    # ------------------------------------------------------------------
    location ^~ /admin/ {
        try_files $uri /index.php?$query_string;
    }

    location = /login {
        try_files $uri /index.php?$query_string;
    }

    location = /logout {
        try_files $uri /index.php?$query_string;
    }

    # API ATAYLAB TASHQARIGA OCHILMAGAN.
    #
    # Next.js Laravelga localhostdan boradi (BACKEND_URL=http://127.0.0.1:8000),
    # shuning uchun API prefiksi uchun bu yerda `location` kerak emas.
    # Tashqaridan kelgan so'rov Next.js ga tushadi va 404 oladi — maxfiy
    # prefiks shu tariqa haqiqatan yopiq qoladi.
    #
    # Agar kelajakda API tashqi iste'molchiga kerak bo'lsa, o'shanda alohida
    # `location` qo'shiladi va throttle qayta ko'rib chiqiladi.

    # Laravelning kirish nuqtasidan boshqa hech qanday PHP fayl bajarilmasin.
    # `public/` ichida adminer kabi begona skriptlar qolib ketishi mumkin;
    # ular bajarilsa, bazaga to'g'ridan-to'g'ri kirish yo'li ochiladi.
    # Bu qoida quyidagi `.php` qoidasidan OLDIN turishi shart.
    location ~ ^/(?!index\.php$).*\.php$ {
        deny all;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 60s;
    }

    # ------------------------------------------------------------------
    # Qolgan hamma narsa — Next.js
    # ------------------------------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Yashirin fayllar (.env, .git) hech qachon berilmasin.
    location ~ /\.(?!well-known).* {
        deny all;
    }
}
