# ---------------------------------------------------------------------
# GSPI backend — nginx namunasi
#
# Bu server Kerio Control TESKARI PROKSISI ORTIDA turadi.
#
#   brauzer / ahost  ──HTTPS──▶  Kerio (198.163.204.233)
#                                   │  HTTPS shu yerda tugaydi
#                                   └──HTTP:80──▶  shu server
#
# Shundan kelib chiqadigan uchta qoida:
#
#   1. Bu yerda SSL sozlanmaydi. Sertifikat Kerio'da (*.gspi.uz uchun
#      wildcard). Laravel serverida Let's Encrypt kerak emas.
#   2. HTTPS ga qayta yo'naltirish YOZILMASIN. Kerio HTTP yuboradi;
#      redirect qo'yilsa cheksiz aylanish (ERR_TOO_MANY_REDIRECTS) bo'ladi.
#   3. Haqiqiy mijoz IP'si `X-Forwarded-For` da keladi. `real_ip` moduli
#      bo'lmasa, hamma so'rov Kerio'dan kelgandek ko'rinadi va IP bo'yicha
#      cheklash ishlamaydi.
#
# Nusxa olgach ALBATTA to'g'irlang:
#   server_name, root katalogi, php-fpm socket nomi,
#   KERIO_ICHKI_IP, API prefiksi, AHOST_IP.
# ---------------------------------------------------------------------

server {
    listen 80;
    listen [::]:80;

    server_name admin.gspi.uz;

    root /var/www/gspi-backend/public;
    index index.php;

    # Kerio yuborgan haqiqiy mijoz IP'sini tan olamiz. Usiz quyidagi
    # `allow` qoidasi Kerio'ning o'z manzilini ko'radi va hech qachon
    # to'g'ri ishlamaydi.
    set_real_ip_from <KERIO_ICHKI_IP>;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 20M;   # rasm va hujjat yuklash uchun

    charset utf-8;

    access_log /var/log/nginx/gspi-access.log;
    error_log  /var/log/nginx/gspi-error.log;

    # ------------------------------------------------------------------
    # Yuklangan fayllar — nginx o'zi beradi, PHP aralashmaydi.
    # ------------------------------------------------------------------
    location ^~ /upload/ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    location ^~ /storage/ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    location ^~ /assets/ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    # ------------------------------------------------------------------
    # API — FAQAT frontend serveri uchun.
    #
    # `<API_PREFIKSI>` o'rniga `.env` dagi `API_PREFIX` qiymatini qo'ying.
    # `<AHOST_IP>` — ahost.uz serverining tashqi IP manzili.
    #
    # Bu qoida yuqoridagi `set_real_ip_from` ga bog'liq: usiz nginx
    # Kerio'ning manzilini ko'radi va hamma so'rovni rad etadi.
    # ------------------------------------------------------------------
    location ^~ /<API_PREFIKSI>/ {
        allow <AHOST_IP>;
        deny  all;

        try_files $uri /index.php?$query_string;
    }

    # ------------------------------------------------------------------
    # Admin panel — xodimlar uchun, IP bilan cheklanmaydi.
    # ------------------------------------------------------------------
    location ^~ /admin/ {
        try_files $uri /index.php?$query_string;
    }

    location = /login {
        try_files $uri /index.php?$query_string;
    }

    location = /logout {
        try_files $uri /index.php?$query_string;
    }

    # Laravelning kirish nuqtasidan boshqa hech qanday PHP fayl
    # bajarilmasin. `public/` ichida adminer kabi begona skriptlar
    # qolib ketishi mumkin; ular bajarilsa, bazaga to'g'ridan-to'g'ri
    # kirish yo'li ochiladi.
    # Bu qoida quyidagi `.php` qoidasidan OLDIN turishi shart.
    location ~ ^/(?!index\.php$).*\.php$ {
        deny all;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;

        # Kerio HTTPS'ni tugatgani uchun PHP so'rovni HTTP deb ko'radi.
        # Laravel to'g'ri manzil qurishi uchun sxemani uzatamiz —
        # `.env` dagi `TRUSTED_PROXIES` bilan birga ishlaydi.
        fastcgi_param HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;

        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 60s;
    }

    # ------------------------------------------------------------------
    # Qolgan hamma narsa — Laravelga.
    #
    # Sayt sahifalari bu yerda EMAS: ular gspi.uz da, ahost serverida.
    # Shuning uchun bu yerga tushgan begona so'rov 404 oladi.
    # ------------------------------------------------------------------
    location / {
        try_files $uri /index.php?$query_string;
    }

    # Yashirin fayllar (.env, .git) hech qachon berilmasin.
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
    }
}
